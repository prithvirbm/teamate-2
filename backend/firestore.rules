rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow all authenticated users for now to facilitate testing
    match /{document=**} {
      allow read, write: if request.auth != null || true; // TRUE for development ease
    }
    
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /sos_events/{eventId} {
      allow read, create, update: if true;
    }

    match /guardian_alerts/{alertId} {
      allow read, update: if true;
    }

    match /evidence_vault/{vaultId} {
      allow read: if true;
      allow write: if true; 
    }
  }
}
